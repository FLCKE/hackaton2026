FROM phi3.5

# =====================================================================
#  phi35-financial-lora  —  Version AVEC l'adapter LoRA hérité
#  Utilise réellement les poids fine-tunés de l'équipe précédente
#  (models/phi3_financial/) au lieu d'un simple prompt système.
#
#  PRÉREQUIS : avoir lancé ./convert_lora.sh pour produire
#  ./build/phi3_financial_lora.gguf à partir de l'adapter safetensors.
#  (l'adapter est stocké en git-LFS : faire `git lfs pull` avant)
# =====================================================================

SYSTEM """
You are a financial assistant specialized in helping financial analysts at TechCorp Industries.
You provide accurate and helpful information about finance, investments, budgeting, trading, and economic concepts.
Always answer concisely, in a professional tone. If you are unsure, say so rather than inventing figures.
"""

# Adapter LoRA converti au format GGUF (voir convert_lora.sh)
ADAPTER ./build/phi3_financial_lora.gguf

PARAMETER temperature 0.3
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER num_predict 512
PARAMETER num_ctx 4096
PARAMETER stop "<|end|>"
PARAMETER stop "<|user|>"
PARAMETER stop "<|assistant|>"
PARAMETER stop "<|system|>"
